---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Shelf from '../components/Shelf.astro';
import Features from '../components/Features.astro';
import Who from '../components/Who.astro';
import Download from '../components/Download.astro';
import Footer from '../components/Footer.astro';
import { latestRelease } from '../data/release';

const release = await latestRelease();
---
<Base title="Typewriter: write your book, keep your world" description="A free desktop app for books and series. Chapters and scenes, characters, maps, timelines and checks, all offline on your computer. For Windows and Linux.">
  <Nav />
  <main>
    <Hero release={release} />
    <Marquee />
    <Shelf />
    <Features />
    <Who />
    <Download release={release} />
  </main>
  <Footer />
</Base>
