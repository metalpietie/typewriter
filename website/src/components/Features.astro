---
import { Image } from 'astro:assets';
import { cards } from '../data/content';
---
<section id="features">
  <div class="wrap">
    <div class="kicker reveal">And there is more</div>
    <h2 class="reveal">Stop juggling ten apps<br />to write one book.</h2>
    <p class="sub reveal">Your manuscript and your story bible live side by side. Point at a linked name in the text, and see the character.</p>
    <div class="bento">
      {cards.map((c) => (
        <article class:list={['card', 'reveal', c.size]} data-spotlight>
          <div class="icon" aria-hidden="true">{c.icon}</div>
          <h3>{c.title}</h3>
          <p>{c.text}</p>
          {c.shot && <Image class="pic" src={c.shot} alt="" widths={[500, 800]} sizes="(max-width: 900px) 70vw, 500px" loading="lazy" />}
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .bento { display: grid; grid-template-columns: repeat(6, 1fr); grid-auto-rows: 260px; gap: 16px; margin-top: 56px; }
  .card { transition: opacity .9s, transform .9s cubic-bezier(.2, .8, .2, 1), border-color .3s; }
  .card:hover { border-color: rgba(61, 139, 246, .25); }
  .card { position: relative; grid-column: span 2; border-radius: 20px; border: 1px solid var(--line); background: var(--panel); padding: 26px; overflow: hidden; isolation: isolate; }
  .card::before { content: ''; position: absolute; inset: 0; background: radial-gradient(400px circle at var(--x, -100px) var(--y, -100px), rgba(61, 139, 246, .18), transparent 50%); z-index: -1; opacity: 0; transition: opacity .4s; }
  .card::after { content: ''; position: absolute; inset: 0; border-radius: inherit; padding: 1px; background: radial-gradient(300px circle at var(--x, -100px) var(--y, -100px), rgba(61, 139, 246, .8), transparent 60%);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude; pointer-events: none; opacity: 0; transition: opacity .4s; }
  .card:hover::before, .card:hover::after { opacity: 1; }
  .card.wide { grid-column: span 4; }
  .card.tall { grid-row: span 2; }
  h3 { margin: 0 0 6px; font-size: 22px; letter-spacing: -.02em; }
  p { margin: 0; color: var(--muted); font-size: 15px; max-width: 34ch; }
  .wide p { max-width: 30ch; }
  .icon { width: 42px; height: 42px; border-radius: 12px; display: grid; place-items: center; background: rgba(61, 139, 246, .12); color: var(--accent); margin-bottom: 18px; font-size: 20px; }
  .card :global(.pic) { position: absolute; right: -40px; bottom: -40px; width: 70%; height: auto; border-radius: 12px; border: 1px solid var(--line); transform: rotate(-4deg); transition: transform .5s cubic-bezier(.2, .8, .2, 1); box-shadow: 0 20px 50px rgba(0, 0, 0, .5); }
  .card:hover :global(.pic) { transform: rotate(-2deg) translate(-12px, -12px) scale(1.03); }
  .tall :global(.pic) { width: 120%; right: -50%; }
  .wide :global(.pic) { width: 50%; }
  @media (max-width: 900px) {
    .bento { grid-template-columns: 1fr; grid-auto-rows: auto; }
    .card, .card.wide { grid-column: auto; min-height: 200px; }
    .card.tall { grid-row: auto; min-height: 320px; }
    .card:has(:global(.pic)) { min-height: 300px; }
  }
</style>
