---
import { REPO_URL, RELEASES_URL } from '../data/release';
---
<footer class="wrap">
  <span>Typewriter · a desktop app for writers</span>
  <span class="links">
    <a data-umami-event="GitHub" data-umami-event-place="footer" href={REPO_URL}>GitHub</a>
    <a href={RELEASES_URL.replace(/\/latest$/, '')}>All releases</a>
    <a href={REPO_URL + '/blob/main/docs/tutorial.md'}>Tutorial</a>
    <a href={REPO_URL + '/blob/main/docs/using-the-app.md'}>Guide</a>
  </span>
</footer>

<style>
  footer { padding: 40px 24px 60px; color: var(--muted); font-size: 14px; display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; border-top: 1px solid var(--line); }
  .links { display: flex; gap: 20px; flex-wrap: wrap; }
  a { transition: color .2s; }
  a:hover { color: var(--text); }
</style>
