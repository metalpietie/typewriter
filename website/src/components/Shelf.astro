---
// The tour: a shelf of books. A click on a book opens it below (text and screenshot).
// All panels are in the HTML, so the page works without JavaScript (then the first book is open).
import { Image } from 'astro:assets';
import { books } from '../data/content';
---
<section class="shelf-sec" id="shelf">
  <div class="wrap">
    <div class="head">
      <div><div class="kicker reveal">Take the tour</div><h2 class="reveal">Pull a book<br />from the shelf.</h2></div>
      <div class="hint reveal">click a book · or use ← →</div>
    </div>

    <div class="shelf">
      <div class="books" role="tablist" aria-label="Features">
        {books.map((b, i) => (
          <button role="tab" id={`book-${b.id}`} aria-controls={`panel-${b.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-i={i}
            style={`--c1:${b.from};--c2:${b.to};--glow:${b.glow};--h:${b.h}px;--w:${b.w ?? 62}px;--r:${b.r ?? 0}deg`} class:list={['book', { sel: i === 0 }]}>
            <span class="ic" aria-hidden="true">{b.icon}</span><span class="t">{b.spine}</span><span class="tip" aria-hidden="true">{b.tip}</span>
          </button>
        ))}
        <a class="slot" href="#download" title="Download Typewriter">+<small>your book</small></a>
      </div>
      <div class="board"></div>
    </div>

    <div class="open" style={`--glow:${books[0].glow}`}>
      <div class="panels">
        {books.map((b, i) => (
          <div class:list={['panel', { on: i === 0 }]} role="tabpanel" id={`panel-${b.id}`} aria-labelledby={`book-${b.id}`} data-glow={b.glow}>
            <div class="chip">{String(i + 1).padStart(2, '0')} · {b.spine}</div>
            <h3>{b.title}</h3>
            <p>{b.text}</p>
            <ul>{b.list.map((x) => <li>{x}</li>)}</ul>
          </div>
        ))}
        <div class="pager"><button class="prev" aria-label="Previous book">←</button><button class="next" aria-label="Next book">→</button></div>
      </div>
      <div class="viewer">
        <div class="tilt" data-tilt="8">
          {books.map((b, i) => <Image class={i === 0 ? "on" : undefined} src={b.shot} alt={`Typewriter: ${b.spine}`} widths={[600, 900, 1400]} sizes="(max-width: 900px) 100vw, 640px" loading={i === 0 ? 'eager' : 'lazy'} />)}
          <div class="glare"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { reduceMotion } from '../scripts/effects';
  const root = document.querySelector<HTMLElement>('.shelf-sec')!;
  const bookEls = [...root.querySelectorAll<HTMLButtonElement>('.book')];
  const panels = [...root.querySelectorAll<HTMLElement>('.panel')];
  const shots = [...root.querySelectorAll<HTMLImageElement>('.viewer img')];
  const open = root.querySelector<HTMLElement>('.open')!;
  const row = root.querySelector<HTMLElement>('.books')!;
  let cur = 0;

  function pick(i: number, focus = false) {
    i = (i + bookEls.length) % bookEls.length;
    if (i === cur) return;
    cur = i;
    bookEls.forEach((b, n) => { b.classList.toggle('sel', n === i); b.setAttribute('aria-selected', String(n === i)); b.tabIndex = n === i ? 0 : -1; });
    panels.forEach((p, n) => p.classList.toggle('on', n === i));
    shots.forEach((s, n) => s.classList.toggle('on', n === i));
    open.style.setProperty('--glow', panels[i].dataset.glow!);
    if (focus) bookEls[i].focus();
  }
  bookEls.forEach((b, i) => b.addEventListener('click', () => pick(i)));
  row.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') { e.preventDefault(); pick(cur + 1, true); }
    if (e.key === 'ArrowLeft') { e.preventDefault(); pick(cur - 1, true); }
    if (e.key === 'Home') { e.preventDefault(); pick(0, true); }
    if (e.key === 'End') { e.preventDefault(); pick(bookEls.length - 1, true); }
  });
  root.querySelector('.prev')!.addEventListener('click', () => pick(cur - 1));
  root.querySelector('.next')!.addEventListener('click', () => pick(cur + 1));

  // the books drop onto the shelf when it comes into view
  row.classList.add('waiting');
  new IntersectionObserver((es, o) => {
    if (!es[0].isIntersecting) return;
    o.disconnect();
    bookEls.forEach((b, i) => setTimeout(() => b.classList.add('in'), reduceMotion ? 0 : 110 * i));
    setTimeout(() => row.classList.add('done'), reduceMotion ? 0 : 110 * bookEls.length + 300);
  }, { threshold: 0.35 }).observe(row);
</script>

<style>
  .shelf-sec { padding: 130px 0 40px; }
  .head { display: flex; justify-content: space-between; align-items: end; gap: 24px; flex-wrap: wrap; }
  .head h2 { margin-bottom: 0; }
  .hint { font: 13px var(--mono); color: var(--muted); }
  .shelf { position: relative; margin: 50px auto 0; max-width: 980px; }
  .books { display: flex; align-items: flex-end; justify-content: center; gap: 10px; height: 340px; padding: 0 20px; position: relative; z-index: 2; }

  .book { position: relative; flex: 0 0 var(--w); height: var(--h); border: 0; padding: 0; cursor: pointer; color: #fff; font: inherit;
    border-radius: 5px 7px 3px 3px; background: linear-gradient(90deg, rgba(255, 255, 255, .14), transparent 18%, transparent 82%, rgba(0, 0, 0, .35)), linear-gradient(160deg, var(--c1), var(--c2));
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .12); transform: rotate(var(--r)); transform-origin: bottom center;
    transition: transform .35s cubic-bezier(.3, 1.6, .5, 1), box-shadow .35s, filter .35s; }
  .waiting .book:not(.in) { transform: translateY(-520px) rotate(var(--r)); opacity: 0; transition: none; }
  .book.in { transition: transform .9s cubic-bezier(.3, 1.4, .5, 1), opacity .2s, box-shadow .35s, filter .35s; }
  .books:has(.sel) .book:not(.sel):not(:hover):not(:focus-visible) { filter: saturate(.6) brightness(.7); }
  .book:hover, .book:focus-visible { transform: translateY(-22px) rotate(0); outline: none; box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .25), 0 24px 40px -12px var(--glow); }
  .book.sel { transform: translateY(-46px) rotate(0); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .4), 0 0 0 2px var(--glow), 0 30px 60px -10px var(--glow); }
  .t { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%) rotate(-90deg); white-space: nowrap; font-weight: 700; font-size: 15px; letter-spacing: .08em; text-transform: uppercase; }
  .ic { position: absolute; left: 0; right: 0; top: 16px; text-align: center; font-size: 15px; opacity: .85; }
  .book::after { content: ''; position: absolute; left: 10px; right: 10px; bottom: 18px; height: 2px; border-radius: 2px; background: rgba(255, 255, 255, .45); box-shadow: 0 -6px 0 rgba(255, 255, 255, .2); }
  .tip { position: absolute; bottom: calc(100% + 18px); left: 50%; transform: translate(-50%, 8px); padding: 6px 10px; border-radius: 8px; white-space: nowrap; font: 12px var(--mono); background: rgba(17, 18, 25, .92); border: 1px solid var(--line); color: var(--text); opacity: 0; pointer-events: none; transition: all .2s; }
  .book:hover .tip { opacity: 1; transform: translate(-50%, 0); }
  .book.sel .tip { display: none; }

  .slot { flex: 0 0 62px; height: 210px; border: 1.5px dashed rgba(255, 255, 255, .22); border-radius: 6px; display: grid; place-items: center; color: var(--muted); font-size: 24px; transition: opacity .6s, border-color .2s, color .2s; position: relative; }
  .waiting:not(.done) .slot { opacity: 0; }
  .slot:hover { border-color: var(--accent); color: var(--accent); }
  .slot small { position: absolute; bottom: -30px; white-space: nowrap; font: 11px var(--mono); }
  .board { position: relative; z-index: 3; height: 16px; border-radius: 6px; background: linear-gradient(180deg, rgba(255, 255, 255, .16), rgba(255, 255, 255, .04)); border: 1px solid rgba(255, 255, 255, .12); backdrop-filter: blur(8px); box-shadow: 0 1px 0 rgba(128, 130, 255, .6) inset, 0 30px 60px -20px rgba(128, 130, 255, .5); }
  .board::after { content: ''; position: absolute; left: 10%; right: 10%; top: 100%; height: 60px; background: radial-gradient(ellipse at top, rgba(128, 130, 255, .25), transparent 70%); }

  .open { display: grid; grid-template-columns: 1fr 1.35fr; gap: 56px; align-items: center; margin-top: 70px; }
  .panels { display: grid; }
  .panel { grid-area: 1 / 1; opacity: 0; visibility: hidden; transform: translateY(14px); transition: opacity .35s, transform .45s cubic-bezier(.2, .8, .2, 1), visibility 0s .35s; }
  .panel.on { opacity: 1; visibility: visible; transform: none; transition: opacity .45s .1s, transform .55s .1s cubic-bezier(.2, .8, .2, 1), visibility 0s; }
  .pager { grid-area: 2 / 1; display: flex; gap: 8px; margin-top: 26px; }
  .pager button { width: 40px; height: 40px; border-radius: 12px; border: 1px solid var(--line); background: rgba(255, 255, 255, .03); color: var(--text); cursor: pointer; font-size: 16px; transition: border-color .2s, background .2s; }
  .pager button:hover { border-color: var(--accent); background: rgba(128, 130, 255, .1); }
  .chip { display: inline-flex; gap: 8px; align-items: center; font: 500 12px var(--mono); color: var(--glow); letter-spacing: .1em; text-transform: uppercase; }
  .chip::before { content: ''; width: 18px; height: 4px; border-radius: 2px; background: var(--glow); box-shadow: 0 0 12px var(--glow); }
  h3 { font-size: clamp(28px, 3.6vw, 44px); letter-spacing: -.03em; line-height: 1.08; margin: 12px 0 14px; }
  .panel p { color: var(--muted); font-size: 17px; margin: 0 0 18px; max-width: 42ch; }
  ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  li { display: flex; gap: 10px; align-items: baseline; }
  li::before { content: '✦'; color: var(--glow); font-size: 12px; }
  .viewer { position: relative; }
  .viewer::before { content: ''; position: absolute; inset: 10% 5% -8%; background: radial-gradient(closest-side, var(--glow), transparent); opacity: .35; z-index: -1; transition: background .5s; }
  .viewer .tilt { aspect-ratio: 1400 / 850; }
  .viewer .tilt :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transform: scale(1.04); transition: opacity .5s, transform .8s cubic-bezier(.2, .8, .2, 1); }
  .viewer .tilt :global(img.on) { opacity: 1; transform: none; }

  @media (max-width: 900px) {
    .books { gap: 5px; height: 280px; padding: 0 4px; }
    .book { flex-basis: calc(var(--w) * .6); height: calc(var(--h) * .78); }
    .t { font-size: 11px; } .ic, .tip, .slot small, .hint { display: none; }
    .slot { flex-basis: 38px; height: 150px; }
    .open { grid-template-columns: 1fr; gap: 30px; margin-top: 50px; }
    .viewer { order: -1; }
  }
</style>
